{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "isolatedModules": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "scripts", "e2e", "vite.config.ts", "playwright.config.ts"]
}
